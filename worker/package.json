    "express": "^5.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.542",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "typescript": "^5"
  }
