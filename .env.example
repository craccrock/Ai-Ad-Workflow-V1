# Fill in each value right after the "=" with no spaces or quotes.
# Comments sit on their own lines so this file can be pasted straight into Vercel.

# ── AI providers ─────────────────────────────────────────────
# Kie.ai API key: primary provider for every model (Kie dashboard → API Keys)
KIE_API_KEY=
# ElevenLabs API key for voiceovers, straight from your account (elevenlabs.io/app/settings/api-keys).
# Uses your ElevenLabs plan allowance and your own voice library, clones included.
ELEVENLABS_API_KEY=
# Google Gemini API key: backup for Nano Banana + Omni Flash (aistudio.google.com/apikey)
GOOGLE_AI_API_KEY=
# Set to "on" to send failed Kie jobs for those models to Google. Leave empty (off) until billing works on the Google key.
GOOGLE_BACKUP=

# ── Supabase (Project Settings → API Keys) ───────────────────
# Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (or legacy anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (or legacy service_role key). Never share this.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────
# Random string from `openssl rand -hex 32`. Never change it after creating API keys.
API_SECRET_SALT=
# Leave blank on Vercel's default address; set it if you use a custom domain.
NEXT_PUBLIC_APP_URL=
# Day boundaries on the Spend page
SPEND_TIMEZONE=America/New_York
# Max USD each API key (MCP / scripts) can spend per rolling 24 hours. Blank = $500; "off" = no cap.
API_DAILY_SPEND_CAP_USD=
# Days generated files are kept before the daily cleanup deletes them. Blank = 7; "off" = keep everything.
# Cards, prompts and costs are always kept; uploaded reference files are never deleted.
RETENTION_DAYS=
# Needed for the daily cron jobs (status sweep + cleanup). Any long random string; set the same value in Vercel.
CRON_SECRET=
